# Node
client/node_modules/
client/build
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/

# Local config and certs
client/.env
client/cert/
server/go/src/.env

# Go build output
server/go/bin/
server/go/pkg/
# binary produced by `make run` / `make server-bin`
server/go/src/trivia-server

# Dependencies vendored into the pre-modules GOPATH layout
server/go/src/github.com
server/go/src/go.mongodb.org
server/go/src/golang.org
server/go/src/gopkg.in
server/go/src/google.golang.org

# Uploaded question images. IMAGE_DIR defaults to "images" relative to the
# working directory, so it lands at the repo root when the server is started
# from there, and under server/go/src when started from the module directory.
/images/
server/go/src/images

# SQLite database. DB_PATH defaults to "data/trivia.db" relative to the working
# directory, so it can land at either of the same two spots.
/data/
server/go/src/data

# Editors
.idea/

# Reasonix agent workspace and config
.reasonix/
reasonix.toml

# Stray package downloads -- a 39M containerd RPM was committed by accident once
*.rpm
*.deb
